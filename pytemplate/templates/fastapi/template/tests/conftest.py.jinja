def alembic_config(url: str) -> Config:
    """Return an Alembic config that migrates `url` without reconfiguring logging."""
    config = Config(str(ROOT / "alembic.ini"))
    config.attributes["database_url"] = url
    config.attributes["configure_logging"] = False
    return config


@pytest.fixture
def migrated(settings: Settings) -> Settings:
    """Apply every migration to this test's private SQLite file."""
    command.upgrade(alembic_config(settings.DATABASE_URL.get_secret_value()), "head")
    return settings
