"""Tests for application settings."""

import pytest
from pydantic import ValidationError

from {{ package_name }}.core.config import Settings


def test_defaults_deny_wildcard_hosts_and_origins() -> None:
    settings = Settings(_env_file=None)

    assert "*" not in settings.ALLOWED_HOSTS
    assert settings.CORS_ORIGINS == []


def test_production_rejects_wildcard_hosts() -> None:
    with pytest.raises(ValidationError, match="not allowed in production"):
        Settings(_env_file=None, ENVIRONMENT="production", ALLOWED_HOSTS=["*"])
