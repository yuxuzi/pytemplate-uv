# Copy to .env for local overrides. .env is git-ignored and must never be committed.
# Every setting is optional in development; production values come from the deployment
# environment, never from a file in the repository.
{{ package_name|upper }}_ENVIRONMENT=development
{{ package_name|upper }}_DEBUG=false
{{ package_name|upper }}_HOST=127.0.0.1
{{ package_name|upper }}_PORT=8000
{{ package_name|upper }}_ALLOWED_HOSTS=["localhost","127.0.0.1"]
{{ package_name|upper }}_CORS_ORIGINS=[]
{{ package_name|upper }}_LOG_LEVEL=INFO
{{ package_name|upper }}_LOG_FORMAT=text
{%- if 'database' in components %}
# Secret in production: postgresql+asyncpg://user:password@host/db (with `uv sync --group postgres`).
{{ package_name|upper }}_DATABASE_URL=sqlite+aiosqlite:///./{{ project_name }}.db
{%- endif %}
{%- if 'worker' in components %}
{{ package_name|upper }}_WORKER_MAX_CONCURRENCY=4
{%- endif %}
{%- if 'auth-api-key' in components %}
# Secret: a JSON list of {"name", "sha256", "scopes"} entries from `uv run {{ package_name }} hash-api-key`.
# {{ package_name|upper }}_API_KEYS=[{"name":"local","sha256":"<64 hex characters>","scopes":["examples:read","examples:write","jobs"]}]
{%- endif %}
{%- if 'auth-oidc' in components %}
# {{ package_name|upper }}_OIDC_ISSUER=https://login.example.com/
# {{ package_name|upper }}_OIDC_AUDIENCE={{ project_name }}
# {{ package_name|upper }}_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
{{ package_name|upper }}_OIDC_ALGORITHMS=["RS256"]
{%- endif %}
