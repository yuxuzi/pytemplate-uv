# Application Configuration
{{cookiecutter.package_name|upper}}_APP_NAME={{cookiecutter.project_name}}
{{cookiecutter.package_name|upper}}_APP_VERSION=0.1.0
{{cookiecutter.package_name|upper}}_ENVIRONMENT=development
{{cookiecutter.package_name|upper}}_DEBUG=false

# Server Settings
{{cookiecutter.package_name|upper}}_HOST=0.0.0.0
{{cookiecutter.package_name|upper}}_PORT=8000

# Database Settings
{{cookiecutter.package_name|upper}}_DATABASE_URL=sqlite+aiosqlite:///./{{cookiecutter.project_name}}.db

# Security Settings
{{cookiecutter.package_name|upper}}_SECRET_KEY=replace-this-before-production
{{cookiecutter.package_name|upper}}_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
{{cookiecutter.package_name|upper}}_API_V1_PREFIX=/api/v1
{{cookiecutter.package_name|upper}}_DOCS_URL=/docs
# {{cookiecutter.package_name|upper}}_REDOC_URL=/redoc
{{cookiecutter.package_name|upper}}_OPENAPI_URL=/openapi.json

# CORS Settings
{{cookiecutter.package_name|upper}}_CORS_ORIGINS=["*"]
# {{cookiecutter.package_name|upper}}_CORS_METHODS=["*"]
# {{cookiecutter.package_name|upper}}_CORS_HEADERS=["*"]

# Logging Settings
{{cookiecutter.package_name|upper}}_LOG_LEVEL=INFO
{{cookiecutter.package_name|upper}}_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# {{cookiecutter.package_name|upper}}_LOG_FILE=my-fastapi.log

# Optional: Email Configuration
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=user@example.com
# EMAIL_PASSWORD=securepassword
# EMAIL_USE_TLS=true
