"""Application settings, read from prefixed environment variables and an optional .env file."""

from functools import lru_cache
from typing import Literal, Self

from pydantic import model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Typed settings; override any field with a prefixed environment variable."""

    model_config = SettingsConfigDict(
        env_prefix="{{ package_name|upper }}_",
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=True,
        extra="ignore",
    )

    APP_NAME: str = "{{ project_name }}"
    APP_VERSION: str = "0.1.0"
    ENVIRONMENT: Literal["development", "test", "production"] = "development"
    DEBUG: bool = False

    HOST: str = "127.0.0.1"
    PORT: int = 8000

    DATABASE_URL: str = "sqlite+aiosqlite:///./{{ project_name }}.db"

    # Deny by default: list the host names and browser origins you actually serve.
    ALLOWED_HOSTS: list[str] = ["localhost", "127.0.0.1"]
    CORS_ORIGINS: list[str] = []

    API_V1_PREFIX: str = "/api/v1"
    DOCS_URL: str | None = "/docs"
    OPENAPI_URL: str | None = "/openapi.json"

    LOG_LEVEL: str = "INFO"
    LOG_FORMAT: str = "%(asctime)s %(levelname)s %(name)s %(message)s"

    @model_validator(mode="after")
    def _reject_wildcards_in_production(self) -> Self:
        if self.ENVIRONMENT == "production" and (
            "*" in self.ALLOWED_HOSTS or "*" in self.CORS_ORIGINS
        ):
            raise ValueError(
                "Wildcard ALLOWED_HOSTS or CORS_ORIGINS are not allowed in production."
            )
        return self


@lru_cache
def get_settings() -> Settings:
    """Return the process-wide settings instance."""
    return Settings()
