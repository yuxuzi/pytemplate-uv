@pytest.mark.parametrize("algorithms", [["HS256"], ["none"], []])
def test_symmetric_and_empty_algorithms_are_refused(algorithms: list[str]) -> None:
    with pytest.raises(ValidationError, match="asymmetric"):
        Settings(_env_file=None, OIDC_ALGORITHMS=algorithms)
