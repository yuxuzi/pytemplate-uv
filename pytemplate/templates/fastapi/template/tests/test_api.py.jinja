"""HTTP-level tests for the API."""

from httpx import ASGITransport, AsyncClient

from {{ package_name }}.main import app

EXAMPLES = "/api/v1/examples/"


async def _create(client: AsyncClient, name: str = "Alpha") -> dict[str, object]:
    response = await client.post(EXAMPLES, json={"name": name, "description": "An example"})
    assert response.status_code == 201, response.text
    body: dict[str, object] = response.json()
    return body


async def test_health_reports_status_and_security_headers(client: AsyncClient) -> None:
    response = await client.get("/health")

    assert response.status_code == 200
    assert response.json()["status"] == "ok"
    assert response.headers["X-Content-Type-Options"] == "nosniff"
    assert response.headers["X-Request-ID"]


async def test_create_and_get_example(client: AsyncClient) -> None:
    created = await _create(client)

    response = await client.get(f"{EXAMPLES}{created['id']}")

    assert response.status_code == 200
    assert response.json()["name"] == "Alpha"
    assert response.json()["updated_at"] is None


async def test_create_rejects_invalid_payload(client: AsyncClient) -> None:
    response = await client.post(EXAMPLES, json={"name": "", "description": "x"})

    assert response.status_code == 422


async def test_missing_example_returns_structured_404(client: AsyncClient) -> None:
    response = await client.get(f"{EXAMPLES}999")

    assert response.status_code == 404
    assert response.json()["code"] == "NOT_FOUND"


async def test_list_examples_paginates(client: AsyncClient) -> None:
    for index in range(3):
        await _create(client, f"Example {index}")

    first_page = await client.get(EXAMPLES, params={"skip": 0, "limit": 2})
    second_page = await client.get(EXAMPLES, params={"skip": 2, "limit": 2})

    assert [item["name"] for item in first_page.json()] == ["Example 0", "Example 1"]
    assert [item["name"] for item in second_page.json()] == ["Example 2"]


async def test_update_changes_only_provided_fields(client: AsyncClient) -> None:
    created = await _create(client)

    response = await client.patch(f"{EXAMPLES}{created['id']}", json={"is_active": False})

    assert response.status_code == 200
    assert response.json()["is_active"] is False
    assert response.json()["name"] == "Alpha"
    assert response.json()["updated_at"] is not None


async def test_delete_example(client: AsyncClient) -> None:
    created = await _create(client)

    deleted = await client.delete(f"{EXAMPLES}{created['id']}")
    missing = await client.get(f"{EXAMPLES}{created['id']}")

    assert deleted.status_code == 204
    assert missing.status_code == 404


async def test_untrusted_host_is_rejected() -> None:
    transport = ASGITransport(app=app)
    async with AsyncClient(transport=transport, base_url="http://evil.example") as other:
        response = await other.get("/health")

    assert response.status_code == 400
