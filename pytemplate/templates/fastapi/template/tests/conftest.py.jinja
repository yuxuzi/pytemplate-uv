def make_token(signing_key: rsa.RSAPrivateKey) -> Callable[..., str]:
    """Return a factory for signed tokens; override any claim to build invalid ones."""

    def make(
        *,
        scopes: tuple[str, ...] = ALL_SCOPES,
        subject: str = "user-1",
        audience: str = AUDIENCE,
        issuer: str = ISSUER,
        expires_in: int = 300,
        key: object = None,
        algorithm: str = "RS256",
    ) -> str:
        now = int(time.time())
        claims = {
            "sub": subject,
            "iss": issuer,
            "aud": audience,
            "iat": now,
            "exp": now + expires_in,
            "scope": " ".join(scopes),
        }
        return jwt.encode(claims, key or signing_key, algorithm=algorithm)

    return make
